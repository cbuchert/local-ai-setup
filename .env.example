# Local MLX inference server — operator configuration.
# llmctl creates .env from this on first run; every value is a working default
# or generated/detected downstream, so editing is optional. .env is gitignored.

# Hostname Caddy serves on (must resolve on the LAN; .local works via mDNS).
SERVER_HOSTNAME=studio.local

# Bearer token required in `Authorization: Bearer <token>` on every request.
# Auto-generated if empty.
API_KEY=

# mlx_lm.server bind address. Keep on loopback — Caddy fronts it with TLS + auth.
MLX_HOST=127.0.0.1:8080

# Hugging Face home; models live under $HF_HOME/hub. Empty = ~/.cache/huggingface.
HF_HOME=

# GPU wired-memory cap in MB. Empty = auto-detected (total RAM − 8 GB headroom).
IOGPU_WIRED_LIMIT_MB=
