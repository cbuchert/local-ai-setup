# Mac Studio Ollama server — operator configuration
# Copy to .env and edit. .env is gitignored.

# Hostname Caddy serves on (must resolve on the LAN; .local works via mDNS).
SERVER_HOSTNAME=studio.local

# Bearer token required in `Authorization: Bearer <token>` on every request.
# Generate with: openssl rand -hex 16
# (scripts/20-render-config.sh will offer to generate this for you if empty)
OLLAMA_API_KEY=

# Ollama bind address. Keep on loopback — Caddy fronts it with TLS + auth.
OLLAMA_HOST=127.0.0.1:11434

# Where model blobs live. Empty = default (~/.ollama/models).
OLLAMA_MODELS=

# How long a model stays resident after last use.
OLLAMA_KEEP_ALIVE=30m

# Concurrent resident models (e.g. one big chat + one tiny autocomplete).
OLLAMA_MAX_LOADED_MODELS=2

# Concurrent requests per model.
OLLAMA_NUM_PARALLEL=1

# Flash attention + q8_0 KV cache → ~half the KV memory at long context.
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0

# GPU wired memory cap in MB. 57344 = 56 GB on a 64 GB Mac, leaves ~8 GB for macOS.
IOGPU_WIRED_LIMIT_MB=57344
