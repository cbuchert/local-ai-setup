# Caddyfile template — rendered by `llmctl caddy install` (llmctl/caddy.py).
#
# The hostname, the loopback Runner upstream, and the bearer token are
# substituted from .env. The token is rendered straight in; the resulting
# /opt/homebrew/etc/Caddyfile is a root-owned 644 file — acceptable for a
# single-operator headless box.
#
# Streaming-aware reverse proxy: flush_interval -1 + compression off +
# long response_header_timeout are mandatory for token streaming to work.

${SERVER_HOSTNAME} {
    tls internal

    @authorized header Authorization "Bearer ${API_KEY}"
    handle @authorized {
        reverse_proxy ${SHIM_HOST} {
            flush_interval -1
            transport http {
                compression off
                response_header_timeout 10m
                dial_timeout 10s
            }
        }
    }
    respond "Unauthorized" 401
}
