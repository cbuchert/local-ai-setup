# Caddyfile template — rendered by scripts/20-render-config.sh.
#
# ${SERVER_HOSTNAME} is substituted from .env. OLLAMA_API_KEY is NOT
# substituted here — Caddy reads it at runtime via {env.OLLAMA_API_KEY},
# set in Caddy's LaunchDaemon EnvironmentVariables. Keeps the token out of
# the on-disk config file.
#
# Streaming-aware reverse proxy: flush_interval -1 + compression off +
# long response_header_timeout are mandatory for token streaming to work.
# (Research doc §3 "Caddyfile — streaming-aware reverse proxy".)

${SERVER_HOSTNAME} {
    tls internal

    @authorized header Authorization "Bearer {env.OLLAMA_API_KEY}"
    handle @authorized {
        reverse_proxy 127.0.0.1:11434 {
            header_up Host localhost:11434
            flush_interval -1
            transport http {
                compression off
                response_header_timeout 10m
                dial_timeout 10s
            }
        }
    }
    respond "Unauthorized" 401
}
