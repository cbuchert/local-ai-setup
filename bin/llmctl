#!/usr/bin/env bash
# llmctl — exec the CLI package through the project venv.
# Falls back to python3 for development before the venv exists (slice 8 / #8
# creates .venv in pre-bootstrap). PYTHONPATH makes the package importable
# regardless of the caller's cwd.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PY="${ROOT}/.venv/bin/python"
[[ -x "${PY}" ]] || PY="$(command -v python3)"
exec env PYTHONPATH="${ROOT}${PYTHONPATH:+:${PYTHONPATH}}" "${PY}" -m llmctl "$@"
